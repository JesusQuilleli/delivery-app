generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id         Int        @id @default(autoincrement())
  name       String
  slug       String     @unique
  is_active  Boolean    @default(true)
  latitude   Float?
  longitude  Float?
  currency   String     @default("USD")
  usd_rate   Decimal    @default(1.0) @db.Decimal(14, 6)
  ves_rate   Decimal    @default(36.5) @db.Decimal(14, 6)
  cop_rate   Decimal    @default(4000.0) @db.Decimal(14, 6)
  delivery_fee Decimal  @default(0) @db.Decimal(12, 2)
  bank_name   String?
  bank_code   String?
  bank_phone  String?
  bank_id_number String?
  bank_holder String?
  payment_note String?
  industry   String     @default("PHARMACY")
  theme_color String    @default("blue")
  plan       String     @default("EMPRENDEDOR")
  plan_price Decimal    @default(15.0) @db.Decimal(12, 2)
  billing_cycle String  @default("MONTHLY")
  subscription_status String @default("TRIAL")
  trial_ends_at DateTime?
  next_billing_date DateTime?
  subscription_notes String?
  landing_config Json?
  parent_store_id Int?
  parent     Store?     @relation("StoreBranches", fields: [parent_store_id], references: [id])
  branches   Store[]    @relation("StoreBranches")
  categories Category[]
  orders     Order[]
  products   Product[]
  users      User[]
  drivers    Driver[]
  deliveryZones DeliveryZone[]
  subscriptionPayments SubscriptionPayment[]
  prescriptionQuotes PrescriptionQuote[]
}

model SubscriptionPayment {
  id                Int      @id @default(autoincrement())
  store_id          Int
  amount            Decimal  @db.Decimal(12, 2)
  currency          String   @default("USD")
  payment_method    String   @default("PAGO_MOVIL")
  payment_reference String?
  payment_receipt_url String?
  period_start      DateTime
  period_end        DateTime
  status            String   @default("APPROVED")
  notes             String?
  recorded_by       String?
  created_at        DateTime @default(now())
  store             Store    @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id])
}

model User {
  id             Int       @id @default(autoincrement())
  store_id       Int?
  client_token   String    @unique @default(uuid())
  name           String?
  phone          String?
  email          String?
  username       String?   @unique
  password       String?
  role           String    @default("CLIENT")
  failed_attempts Int      @default(0)
  locked_until   DateTime?
  orders         Order[]
  prescriptionQuotes PrescriptionQuote[]
  store          Store?    @relation(fields: [store_id], references: [id])

  @@unique([store_id, email])
  @@unique([store_id, phone])
}

model VerificationCode {
  id         Int      @id @default(autoincrement())
  store_id   Int?
  email      String
  code       String
  expires_at DateTime

  @@unique([store_id, email, code])
}

model Product {
  id           Int         @id @default(autoincrement())
  store_id     Int
  name         String
  price        Decimal     @db.Decimal(12, 2)
  image_url    String?
  is_available Boolean     @default(true)
  description  String?
  is_combo     Boolean     @default(false)
  stock        Int?
  category_id  Int?
  requires_prescription Boolean @default(false)
  prescription_type     String  @default("NONE")
  lot_number   String?
  expires_at   DateTime?
  comboItems   ComboItem[] @relation("ComboItems")
  partOfCombos ComboItem[] @relation("ProductInCombo")
  orderItems   OrderItem[]
  category     Category?   @relation(fields: [category_id], references: [id], onDelete: Cascade)
  store        Store       @relation(fields: [store_id], references: [id])
}

model Order {
  id                Int         @id @default(autoincrement())
  store_id          Int
  user_id           Int
  delivery_address  String
  address_details   String?
  latitude          Float?
  longitude         Float?
  currency          String      @default("USD")
  usd_rate          Decimal     @default(1.0) @db.Decimal(14, 6)
  ves_rate          Decimal     @default(36.5) @db.Decimal(14, 6)
  cop_rate          Decimal     @default(4000.0) @db.Decimal(14, 6)
  subtotal          Decimal     @default(0) @db.Decimal(12, 2)
  delivery_fee      Decimal     @default(0) @db.Decimal(12, 2)
  total_amount      Decimal     @db.Decimal(12, 2)
  stock_breakdown   Json?
  stock_restored    Boolean     @default(false)
  payment_method    String
  payment_reference String?
  status            String      @default("PENDING")
  viewed            Boolean     @default(false)
  client_rating     Int?
  client_review     String?
  createdAt         DateTime    @default(now())
  distance_km       Float?
  estimated_minutes Int?
  cancel_reason     String?
  prescription_url  String?
  prescription_status String @default("NOT_REQUIRED")
  prescription_notes String?
  prescription_type  String  @default("NONE")
  driver_id         Int?
  store             Store       @relation(fields: [store_id], references: [id])
  user              User        @relation(fields: [user_id], references: [id])
  driver            Driver?     @relation(fields: [driver_id], references: [id])
  items             OrderItem[]
}

model OrderItem {
  id         Int     @id @default(autoincrement())
  order_id   Int
  product_id Int
  quantity   Int
  unit_price Decimal @db.Decimal(12, 2)
  order      Order   @relation(fields: [order_id], references: [id])
  product    Product @relation(fields: [product_id], references: [id])
}

model ComboItem {
  id         Int     @id @default(autoincrement())
  combo_id   Int
  product_id Int
  quantity   Int     @default(1)
  combo      Product @relation("ComboItems", fields: [combo_id], references: [id])
  product    Product @relation("ProductInCombo", fields: [product_id], references: [id])
}

model Category {
  id        Int       @id @default(autoincrement())
  store_id  Int
  name      String
  image_url String?
  store     Store     @relation(fields: [store_id], references: [id])
  products  Product[]
}

model Driver {
  id            Int      @id @default(autoincrement())
  store_id      Int
  name          String
  phone         String
  vehicle_plate String?
  is_active     Boolean  @default(true)
  store         Store    @relation(fields: [store_id], references: [id])
  orders        Order[]
}

model DeliveryZone {
  id              Int     @id @default(autoincrement())
  store_id        Int
  name            String
  min_distance_km Decimal @default(0) @db.Decimal(8, 2)
  max_distance_km Decimal? @db.Decimal(8, 2)
  fee             Decimal @db.Decimal(12, 2)
  is_active       Boolean @default(true)
  store           Store   @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id])
}

model PrescriptionQuote {
  id               Int      @id @default(autoincrement())
  store_id         Int
  user_id          Int?
  customer_name    String
  customer_phone   String
  delivery_address String?
  prescription_url String
  notes            String?
  status           String   @default("PENDING")
  items            Json?
  total_usd        Decimal? @db.Decimal(12, 2)
  total_ves        Decimal? @db.Decimal(14, 2)
  admin_notes      String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  store            Store    @relation(fields: [store_id], references: [id], onDelete: Cascade)
  user             User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([store_id])
}
