# Base de datos PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/delivery_db?schema=public

# Servidor
NODE_ENV=development
PORT=3000

# Orígenes permitidos, separados por coma.
# En producción debe contener solo el dominio real.
ALLOWED_ORIGINS=http://localhost:5173

# Cloudinary
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Resend
RESEND_API_KEY=re_tu_api_key

# JWT: usar un valor largo, aleatorio y distinto por entorno
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio

# Pruebas de API (opcional, por defecto http://localhost:3000/api)
# TEST_API_URL=http://localhost:3000/api
