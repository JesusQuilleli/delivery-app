# ========================================================
# ARCHIVO DE CONFIGURACIÓN DE PRODUCCIÓN - TIENDAFAST (VPS)
# Copiar este archivo como: .env.production
# ========================================================

# Dominio y TLS (Caddy 2)
DOMAIN=test.shop-mg.com
ACME_EMAIL=admin@shop-mg.com

# Base de Datos PostgreSQL 16 (Interna en Docker)
POSTGRES_DB=delivery_db
POSTGRES_USER=delivery_user
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_32_CARACTERES

# Seguridad y Autenticación JWT
JWT_SECRET=CAMBIAR_POR_SECRETO_RANDOM_DE_64_CARACTERES
JWT_REFRESH_SECRET=CAMBIAR_POR_SECRETO_REFRESH_RANDOM_DE_64_CARACTERES
ALLOWED_ORIGINS=https://test.shop-mg.com

# Pasarela WhatsApp Evolution API / Baileys
EVOLUTION_API_KEY=CAMBIAR_POR_API_KEY_SECRETA_EVOLUTION
WHATSAPP_BOT_NUMBER=584161804831

# Almacenamiento Cloudinary (Imágenes y Comprobantes)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Datos Iniciales para el Primer SuperAdmin (Script create-superadmin.js)
SUPERADMIN_NAME=Jesús Quillelli
SUPERADMIN_EMAIL=superadmin@tiendafast.com
SUPERADMIN_PASSWORD=CAMBIAR_POR_PASSWORD_SUPERADMIN_SEGURO
SUPERADMIN_PHONE=+584124742535
